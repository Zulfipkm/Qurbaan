<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F6">

    <!-- MAIN APP SCREEN -->
    <LinearLayout
        android:id="@+id/layoutMainApp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Flipkart Blue Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2874F0"
            android:elevation="4dp"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAppBrand"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Qurban"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="italic|bold" />

                <TextView
                    android:id="@+id/tvBrandPlus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="Halal Live Stock ✦"
                    android:textColor="#FFE500"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnChangeLang"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:backgroundTint="#1F5AC2"
                    android:text="🌐 Lang"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍 "
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etSearchQuery"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="ആട്, പോത്ത്, കോഴി തിരയുക..."
                    android:inputType="text"
                    android:textColor="#212121"
                    android:textColorHint="#878787"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Product Feed -->
        <ScrollView
            android:id="@+id/viewHomeFeed"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <LinearLayout
                            android:id="@+id/btnCatAll"
                            android:layout_width="66dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="#E3F2FD"
                                android:gravity="center"
                                android:text="🏷️"
                                android:textSize="20sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="All"
                                android:textColor="#212121"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnCatGoat"
                            android:layout_width="66dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="#E8F5E9"
                                android:gravity="center"
                                android:text="🐐"
                                android:textSize="20sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="ആട്"
                                android:textColor="#212121"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnCatBuffalo"
                            android:layout_width="66dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="#ECEFF1"
                                android:gravity="center"
                                android:text="🐃"
                                android:textSize="20sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="പോത്ത്"
                                android:textColor="#212121"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnCatHen"
                            android:layout_width="66dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="#FFF3E0"
                                android:gravity="center"
                                android:text="🐔"
                                android:textSize="20sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="കോഴി"
                                android:textColor="#212121"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnCatFish"
                            android:layout_width="66dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="#E0F7FA"
                                android:gravity="center"
                                android:text="🐟"
                                android:textSize="20sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="മത്സ്യം"
                                android:textColor="#212121"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/containerProducts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </LinearLayout>
        </ScrollView>

        <!-- Sell View -->
        <ScrollView
            android:id="@+id/viewSellForm"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvSellHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="വിൽപ്പന വിവരങ്ങൾ നൽകുക (Sell Animal)"
                    android:textColor="#2874F0"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerSellCategory"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="#F1F3F6" />

                <EditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="#F1F3F6"
                    android:hint="തലക്കെട്ട് (ഉദാ: തലശ്ശേരി മലബാറി ആട്)"
                    android:padding="10dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etBreed"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="#F1F3F6"
                    android:hint="ഇനം / Breed (മലബാറി, സിരോഹി, നാടൻ)"
                    android:padding="10dp"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <EditText
                        android:id="@+id/etWeight"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="#F1F3F6"
                        android:hint="തൂക്കം (Kg - ലൈവ്)"
                        android:inputType="number"
                        android:padding="10dp"
                        android:textSize="13sp" />

                    <View android:layout_width="8dp" android:layout_height="1dp" />

                    <EditText
                        android:id="@+id/etAge"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="#F1F3F6"
                        android:hint="പ്രായം / പല്ല് (2 പല്ല്)"
                        android:padding="10dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etPrice"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="#F1F3F6"
                    android:hint="വില ₹ (Price)"
                    android:inputType="number"
                    android:padding="10dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etQuality"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="#F1F3F6"
                    android:hint="തീറ്റ / വളർത്തൽ രീതി (ഓർഗാനിക്, പച്ചപ്പുല്ല്)"
                    android:padding="10dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etSellerName"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="#F1F3F6"
                    android:hint="കർഷകൻ / വിൽക്കുന്നയാളുടെ പേര്"
                    android:padding="10dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="#F1F3F6"
                    android:hint="ഫോൺ നമ്പർ (WhatsApp)"
                    android:inputType="phone"
                    android:padding="10dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etLocation"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="#F1F3F6"
                    android:hint="സ്ഥലം / പഞ്ചായത്ത് വാർഡ്"
                    android:padding="10dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etUpi"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="#F1F3F6"
                    android:hint="UPI ID (Advance പേയ്‌മെന്റിനായി)"
                    android:padding="10dp"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSubmitListing"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#FB641B"
                    android:text="പോസ്റ്റ് ചെയ്യുക (List Now)"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </ScrollView>

        <!-- Bottom Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:text="🏠 ഹോം (Home)"
                android:textColor="#2874F0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/navSell"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:text="➕ വിൽക്കാൻ (Sell)"
                android:textColor="#878787"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4-Language Modal -->
    <LinearLayout
        android:id="@+id/layoutLanguageModal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QURBAN • ഖുർബാൻ"
                android:textColor="#2874F0"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Select Language / ഭാഷ തിരഞ്ഞെടുക്കുക"
                android:textColor="#878787"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnLangMalayalam"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#2874F0"
                android:text="മലയാളം (Malayalam)"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnLangEnglish"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#F1F3F6"
                android:text="English"
                android:textColor="#212121" />

            <Button
                android:id="@+id/btnLangHindi"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#F1F3F6"
                android:text="हिन्दी (Hindi)"
                android:textColor="#212121" />

            <Button
                android:id="@+id/btnLangTamil"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#F1F3F6"
                android:text="தமிழ் (Tamil)"
                android:textColor="#212121" />
        </LinearLayout>
    </LinearLayout>

    <!-- ANIMATED SPLASH SCREEN OVERLAY -->
    <LinearLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#2874F0"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Animated Goat Mascot Icon -->
        <TextView
            android:id="@+id/tvSplashGoat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐐"
            android:textSize="84sp" />

        <TextView
            android:id="@+id/tvSplashBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Qurban"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="italic|bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Explore Plus ✦ Live Halal Stock"
            android:textColor="#FFE500"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
